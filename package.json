{
  "name": "tli-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Torchlight: Infinite reward overlay - log engine and mechanic modules",
  "author": "Arsenic",
  "license": "MIT",
  "type": "module",
  "main": "dist/overlay/main.js",
  "scripts": {
    "audit": "tsx src/cli/audit.ts",
    "read-cards": "tsx src/cli/read-cards.ts",
    "read-flames": "tsx src/cli/read-flames.ts",
    "watch": "tsx src/cli/watch.ts",
    "calibrate": "tsx src/cli/calibrate.ts",
    "backfill-salvage": "tsx src/cli/salvage.ts",
    "pull": "tsx src/cli/pull.ts",
    "reports": "tsx src/cli/reports.ts",
    "overlay": "electron src/overlay/start.mjs",
    "build-flame-icons": "tsx src/cli/build-flame-icons.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle": "node bundle.mjs",
    "dist": "node bundle.mjs && electron-builder --win zip --publish never"
  },
  "build": {
    "appId": "io.github.danthespal.tli-overlay",
    "productName": "TLI Overlay",
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "data/black-sail",
        "to": "data/black-sail"
      },
      {
        "from": "data/tessdata-fast",
        "to": "data/tessdata-fast"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "zip"
    },
    "electronLanguages": [
      "en-US"
    ],
    "artifactName": "TLI-Overlay-${version}-win-x64.${ext}",
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  }
}
